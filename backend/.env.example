# Copy to .env. Never commit the filled-in file.
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS

# Authentication. Use independent random secrets of at least 48 characters.
# JWT_SECRET_KEY may be left empty to reuse SECRET_KEY in small deployments.
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_JWT_SECRET_OF_AT_LEAST_48_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=CineRank
JWT_AUDIENCE=CineRank API
JWT_LEEWAY_SECONDS=5
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
AUTH_COOKIE_NAME=cinerank_refresh
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=256
AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=5
AUTH_RATE_LIMIT_REGISTER_PER_HOUR=5
AUTH_RATE_LIMIT_REFRESH_PER_MINUTE=10
AUTH_RATE_LIMIT_LOGOUT_PER_MINUTE=30
AUTH_RATE_LIMIT_EMAIL_PER_HOUR=5

# Public frontend origin used in account verification and password reset links.
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# Configure SMTP to enable verification and password reset delivery.
# Use either SMTP_STARTTLS=true for port 587 or SMTP_SSL=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cinerank.example
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Logging. Console output is human-readable; the file is rotating JSON lines.
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_NAME=cinerank.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

POSTGRES_DB=cinerank
POSTGRES_USER=cinerank
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
PUBLIC_HTTP_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local default. Docker Compose overrides this with its PostgreSQL service URL.
DATABASE_URL=sqlite:///./data/cinerank.db
SQL_POOL_SIZE=5
SQL_MAX_OVERFLOW=10
SQL_POOL_TIMEOUT_SECONDS=30
SQL_POOL_RECYCLE_SECONDS=1800
AUTO_CREATE_SCHEMA=false
MODEL_RELEASE_DIR=./artifacts/models/releases
MODEL_INFERENCE_CACHE_SIZE=1024
MODEL_INFERENCE_USE_GPU=false
MODEL_INFERENCE_REQUIRE_GPU=false

# Optional authoritative metadata source. Either TMDB credential may be used.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Optional general web discovery. Set true only for domains you are authorised to crawl.
WEB_CRAWLER_ENABLED=false
CRAWLER_SEED_URLS=
CRAWLER_MAX_PAGES_PER_RUN=250
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_BODY_BYTES=2000000
CRAWLER_MIN_HOST_DELAY_SECONDS=2.0
CRAWLER_REVISIT_HOURS=24
CRAWLER_RETRY_HOURS=6
CRAWLER_ALLOW_SUBDOMAINS=false

# Background jobs. Daily catalogue sync is scheduled at 12:00 UTC.
CATALOGUE_SORT_BATCH_SIZE=5000
JOB_LEASE_SECONDS=3600
SCHEDULER_POLL_SECONDS=30
MODEL_REFRESH_DAYS=60
MODEL_TRAINING_TIMEOUT_SECONDS=86400
MODEL_PROMOTION_MIN_DELTA=0.002
MODEL_EVALUATION_KS=5,10,20
MODEL_EVALUATION_MAX_USERS=2000
MODEL_EVALUATION_MIN_HIT_RATE_10=0.0

# Training settings for the 60-day challenger run.
CINERANK_TARGET_USERS=10000
CINERANK_MIN_MOVIE_RATINGS=20
