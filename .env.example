# Copy to .env before using Docker Compose. Replace every placeholder.
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHARACTER_SECRET
POSTGRES_DB=cinerank
POSTGRES_USER=cinerank
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_GRAFANA_PASSWORD
PUBLIC_HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080
REDIS_URL=redis://:REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD@redis:6379/0
SQL_POOL_SIZE=5
SQL_MAX_OVERFLOW=10
SQL_POOL_TIMEOUT_SECONDS=30
SQL_POOL_RECYCLE_SECONDS=1800
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Public origin used in email links. Use HTTPS in production.
FRONTEND_BASE_URL=https://cinerank.example
AUTH_RATE_LIMIT_EMAIL_PER_HOUR=5
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# SMTP is required for account verification and password reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cinerank.example
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
MODEL_INFERENCE_USE_GPU=false
MODEL_INFERENCE_REQUIRE_GPU=false
MODEL_INFERENCE_CACHE_SIZE=1024
